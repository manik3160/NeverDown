# Backend API base URL
#
# Set this to your backend origin. It may include or omit the "/api/v1" suffix —
# both formats are handled correctly by the frontend. Do NOT add a trailing slash.
#
# Examples:
#   http://localhost:8000          (local dev — default when this var is unset)
#   https://api.example.com        (VPS / Railway backend)
#   https://api.example.com/api/v1 (explicit path prefix also works)
#
# For Vercel deployments, set this in your Vercel project:
#   Settings → Environment Variables → NEXT_PUBLIC_API_URL
# (env vars with the NEXT_PUBLIC_ prefix must be configured in the Vercel dashboard,
#  not in vercel.json, because they are inlined at build time.)
NEXT_PUBLIC_API_URL=http://localhost:8000
